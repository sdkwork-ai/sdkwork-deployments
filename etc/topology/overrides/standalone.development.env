# SDKWork standalone.development overrides (edit this file, not the resolved profile)
SDKWORK_DEPLOY_PROFILE_ID=standalone.development
SDKWORK_DEPLOY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3900
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true
SDKWORK_DEPLOY_WEB_INTERNAL_API_URL=http://127.0.0.1:3800
SDKWORK_DEPLOY_RUNTIME_ASSIGNMENT_BATCH_SIZE=50
SDKWORK_DEPLOY_RUNTIME_ASSIGNMENT_POLL_INTERVAL_MILLIS=1000
SDKWORK_DEPLOY_RUNTIME_ASSIGNMENT_LEASE_SECONDS=30
