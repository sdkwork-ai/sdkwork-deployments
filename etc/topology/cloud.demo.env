# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_deploy_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=cloud
SDKWORK_DEPLOY_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DEPLOY_PROFILE_ID=cloud.demo
SDKWORK_DEPLOY_APPLICATION_PUBLIC_HTTP_URL=https://deploy-demo.sdkwork.com
SDKWORK_DEPLOY_APPLICATION_APP_HTTP_URL=https://deploy-app-demo.sdkwork.com
SDKWORK_DEPLOY_APPLICATION_BACKEND_HTTP_URL=https://deploy-admin-demo.sdkwork.com
SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DEPLOY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://deploy-demo.sdkwork.com,http://deploy-demo.sdkwork.com,https://deploy-demo.birdcoder.com,http://deploy-demo.birdcoder.com,https://deploy-demo.dtupay.com,http://deploy-demo.dtupay.com,https://deploy-demo.noaper.com,http://deploy-demo.noaper.com,https://deploy-demo.sdkwork.cn,http://deploy-demo.sdkwork.cn,https://deploy-demo.birdcoder.cn,http://deploy-demo.birdcoder.cn,https://deploy-demo.dtupay.cn,http://deploy-demo.dtupay.cn,https://deploy-demo.noaper.cn,http://deploy-demo.noaper.cn,https://deploy-demo.skubc.com,http://deploy-demo.skubc.com,https://deploy-demo.skubc.cn,http://deploy-demo.skubc.cn,https://deploy-demo.zowalk.com,http://deploy-demo.zowalk.com,https://deploy-demo.zowalk.cn,http://deploy-demo.zowalk.cn,https://deploy-demo.offer86.com,http://deploy-demo.offer86.com,https://deploy-demo.offer86.cn,http://deploy-demo.offer86.cn,https://deploy-demo.86offer.com,http://deploy-demo.86offer.com,https://deploy-demo.86offer.cn,http://deploy-demo.86offer.cn,https://deploy-app-demo.sdkwork.com,http://deploy-app-demo.sdkwork.com,https://deploy-app-demo.birdcoder.com,http://deploy-app-demo.birdcoder.com,https://deploy-app-demo.dtupay.com,http://deploy-app-demo.dtupay.com,https://deploy-app-demo.noaper.com,http://deploy-app-demo.noaper.com,https://deploy-app-demo.sdkwork.cn,http://deploy-app-demo.sdkwork.cn,https://deploy-app-demo.birdcoder.cn,http://deploy-app-demo.birdcoder.cn,https://deploy-app-demo.dtupay.cn,http://deploy-app-demo.dtupay.cn,https://deploy-app-demo.noaper.cn,http://deploy-app-demo.noaper.cn,https://deploy-app-demo.skubc.com,http://deploy-app-demo.skubc.com,https://deploy-app-demo.skubc.cn,http://deploy-app-demo.skubc.cn,https://deploy-app-demo.zowalk.com,http://deploy-app-demo.zowalk.com,https://deploy-app-demo.zowalk.cn,http://deploy-app-demo.zowalk.cn,https://deploy-app-demo.offer86.com,http://deploy-app-demo.offer86.com,https://deploy-app-demo.offer86.cn,http://deploy-app-demo.offer86.cn,https://deploy-app-demo