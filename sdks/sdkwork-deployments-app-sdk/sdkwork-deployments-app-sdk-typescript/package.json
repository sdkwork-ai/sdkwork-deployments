{
  "name": "@sdkwork/deployments-app-sdk",
  "version": "0.1.6",
  "description": "SDKWork Deploy App API composed consumer facade.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./application-publisher": {
      "types": "./composed/applicationPublisher/index.ts",
      "import": "./composed/applicationPublisher/index.ts",
      "default": "./composed/applicationPublisher/index.ts"
    }
  },
  "scripts": {
    "build": "pnpm run build:transport && pnpm run typecheck",
    "build:transport": "pnpm --dir generated/server-openapi build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdkwork/drive-app-sdk": "workspace:^",
    "@sdkwork/sdk-common": "^1.0.8",
    "@sdkwork/utils": "^0.11.0"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "composed",
    "generated/server-openapi/dist",
    "generated/server-openapi/src",
    "generated/server-openapi/sdkwork-sdk.json",
    "generated/server-openapi/README.md",
    "generated/server-openapi/LICENSE"
  ]
}
