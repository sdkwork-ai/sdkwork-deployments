{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-deployments",
  "applicationCode": "deploy",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "gatewayBind": "127.0.0.1:3900",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_DEPLOY_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_DEPLOY_ENVIRONMENT",
    "profileId": "SDKWORK_DEPLOY_PROFILE_ID",
    "standaloneGatewayBind": "SDKWORK_DEPLOY_APPLICATION_PUBLIC_INGRESS_BIND",
    "apiGatewayBaseUrl": "SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DEPLOY_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_DEPLOY_APPLICATION_PUBLIC_HTTP_URL"
    },
    "application.app-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DEPLOY_APPLICATION_APP_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_DEPLOY_APPLICATION_APP_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_DEPLOY_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_DEPLOY_APPLICATION_BACKEND_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_DEPLOY_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
