<view class="mp-chips">
  <view
    wx:for="{{templateTypes}}"
    wx:key="key"
    class="mp-chip {{activeType === item.key ? 'mp-chip-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onTypeTap"
  >{{item.label}}</view>
</view>
<view class="mp-chips">
  <view
    wx:for="{{pricingModels}}"
    wx:key="key"
    class="mp-chip {{activePricing === item.key ? 'mp-chip-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onPricingTap"
  >{{item.label}}</view>
</view>
<view class="mp-chips">
  <view
    wx:for="{{sorts}}"
    wx:key="key"
    class="mp-chip {{activeSort === item.key ? 'mp-chip-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onSortTap"
  >{{item.label}}</view>
</view>
<view class="mp-chips">
  <view class="mp-chip {{activeCategory === '' ? 'mp-chip-active' : ''}}" bindtap="onCategoryTap">全部</view>
  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="mp-chip {{activeCategory === item.id ? 'mp-chip-active' : ''}}"
    data-key="{{item.id}}"
    bindtap="onCategoryTap"
  >{{item.displayName}}</view>
</view>
<input class="mp-search" placeholder="搜索模板" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" />
<view wx:if="{{error}}" class="mp-empty">{{error}}</view>
<view wx:elif="{{loading}}" class="mp-empty">加载中…</view>
<view wx:elif="{{items.length === 0}}" class="mp-empty">暂无符合条件的模板。</view>
<view
  wx:for="{{items}}"
  wx:key="id"
  class="mp-card"
  data-uuid="{{item.id}}"
  bindtap="onCardTap"
>
  <view class="mp-title">
    <text wx:if="{{item.isFeatured}}" class="mp-status">精选</text>
    {{item.displayName}}
  </view>
  <view class="mp-summary">{{item.summary}}</view>
  <view class="mp-meta">
    <text class="mp-price {{item.pricingModel === 'FREE' ? 'mp-price-free' : ''}}">{{item.pricingModel === 'PAID' ? '付费 ' + item.priceMinor + ' ' + item.currency : '免费'}}</text>
    <text>{{item.installCount}} 次安装</text>
    <text wx:if="{{entitledMap[item.id]}}" class="mp-status mp-status-active">已获取</text>
  </view>
</view>
<view wx:if="{{hasMore}}" class="mp-more" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多（共 ' + total + ' 个）'}}</view>
